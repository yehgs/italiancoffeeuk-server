{
  "name": "italiancoffee-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js / Express / Prisma / MongoDB API for Italian Coffee UK",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "migrate:export": "node scripts/export-firestore.js",
    "migrate:import": "node --env-file-if-exists=.env scripts/import-firestore.js",
    "migrate:verify": "node --env-file-if-exists=.env scripts/verify-import.js",
    "test": "vitest run",
    "lint": "node --check src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
