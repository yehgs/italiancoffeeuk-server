# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB MUST be a replica set (Prisma uses transactions). Local: docker compose up -d
DATABASE_URL=mongodb://localhost:27017/italiancoffee?replicaSet=rs0&directConnection=true

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

COOKIE_NAME=ic_session
# lax when site and API share a registrable domain; none (HTTPS only) when they do not
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CUSTOMER_SESSION_HOURS=168
ADMIN_SESSION_HOURS=12
BCRYPT_ROUNDS=12
# Number of reverse proxies in front of the API (needed for correct client IPs / rate limiting)
TRUST_PROXY=0


# Cloudflare R2 (S3-compatible). Uploads are disabled until all of these are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket: your custom domain (recommended) or the r2.dev URL. No trailing slash.
R2_PUBLIC_BASE_URL=https://media.example.com
R2_KEY_PREFIX=italiancoffee

# resend (real email via Resend) | console (dev only: prints the link in the log) | none
MAIL_TRANSPORT=console
RESEND_API_KEY=
# Must use a domain you verified in Resend, e.g. Italian Coffee <no-reply@mail.example.com>
MAIL_FROM=Italian Coffee <no-reply@example.com>
MAIL_REPLY_TO=

# Optional first super-admin (password >= 12 chars), then run: npm run db:seed
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
